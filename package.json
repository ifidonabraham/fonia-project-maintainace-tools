{
  "name": "fonia-projects",
  "version": "0.1.0",
  "private": true,
  "description": "Fonia Projects — a collaborative project management tool. A Fonia Labs Product.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:ui": "next dev",
    "build": "next build",
    "start": "tsx server.ts --prod",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@prisma/client": "^6.3.0",
    "cloudinary": "^2.11.0",
    "next": "16.2.9",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/ws": "^8.5.13",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "5.5.4"
  }
}
