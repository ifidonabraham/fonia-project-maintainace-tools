// Fonia Projects — data model
// A Fonia Labs Product.
//
// SQLite keeps this project fully local: no database server, no hosted service.
// Every column that is logically an enum is stored as String and narrowed by
// the union types in lib/types.ts, because SQLite has no native enum support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#38bdf8")
  avatarUrl    String?  // Cloudinary URL for profile photo (null = use color avatar)
  // Onboarding / security tokens
  emailVerified   Boolean  @default(false)
  verifyToken     String?  // email verification token (sha256 hex, expires 24h)
  verifyTokenExp  DateTime?
  resetToken      String?  // password reset token (sha256 hex, expires 1h)
  resetTokenExp   DateTime?
  createdAt    DateTime @default(now())

  memberships   ProjectMember[]
  assignedTasks Task[]           @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreator")
  comments      Comment[]
  notifications Notification[]
  activities    ProjectEvent[]
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  color       String   @default("#38bdf8")
  createdById String
  createdAt   DateTime @default(now())
  archivedAt  DateTime?

  members ProjectMember[]
  columns Column[]
  tasks   Task[]
  events  ProjectEvent[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Column {
  id        String  @id @default(cuid())
  projectId String
  name      String
  position  Float   @default(0)
  isDone    Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  assigneeId  String?
  createdById String
  position    Float     @default(0)
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  completedAt DateTime?
  version     Int       @default(1) // optimistic concurrency guard
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User         @relation("TaskCreator", fields: [createdById], references: [id])
  comments Comment[]

  @@index([projectId, columnId, position])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// Append-only realtime log. `seq` is a global monotonic cursor: a client that
/// reconnects sends the last seq it applied and replays everything after it.
model ProjectEvent {
  seq       Int      @id @default(autoincrement())
  projectId String
  type      String // task.created | task.moved | task.updated | task.deleted | comment.created | member.added ...
  actorId   String
  payload   String // JSON snapshot of the change
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, seq])
}

/// Pending project invitation for someone who doesn't have an account yet.
/// Once they register, the invite is consumed and they are added to the project.
model Invite {
  id        String   @id @default(cuid())
  token     String   @unique // sha256 hex token in the invite link
  email     String            // invitee's email address
  projectId String
  role      String   @default("member")
  inviterId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

/// Notification fan-out. `seq` doubles as the per-user realtime cursor.
model Notification {
  seq       Int       @id @default(autoincrement())
  userId    String
  actorId   String?
  projectId String?
  taskId    String?
  type      String // task.assigned | comment.mention | comment.reply | project.added | task.done | task.due_soon
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seq])
  @@index([userId, readAt])
}
