# Fonia Projects — local environment example template
# Copy this file to .env and fill in the values

# Local SQLite database file (created by: npm run db:reset)
DATABASE_URL="file:./dev.db"

# Signs session JWTs. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Name of the httpOnly session cookie.
SESSION_COOKIE="fonia_projects_session"

# How long a session stays valid (seconds). 30 days.
SESSION_TTL="2592000"

# WebSocket + SSE endpoint both the gateway and the browser use.
REALTIME_PATH="/api/realtime"

# Cloudinary — media storage for avatars and task attachments.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Azure Communication Services — email delivery for onboarding, invites, password reset.
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER=""

# Base URL used to build links in emails (no trailing slash).
APP_BASE_URL="http://localhost:3000"
